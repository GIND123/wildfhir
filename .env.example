APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
DATABASE_PATH=/data/aquafhir.db
FHIR_BASE_URL=http://hapi:8080/fhir
FHIR_WRITE_ENABLED=true
FHIR_TIMEOUT_SECONDS=15
REVIEW_CONFIDENCE_THRESHOLD=0.90
WEBHOOK_SHARED_SECRET=change-me-before-deployment

# --- Gemini co-pilot ---------------------------------------------------------
# Get a key at https://aistudio.google.com/apikey. Leaving it empty is a
# supported mode: the deterministic pipeline runs unchanged and every AI
# endpoint returns 503 with an explanation.
GEMINI_API_KEY=
# gemini-2.5-* models were retired for new API users mid-2026; use a 3.x model.
# `gemini-3.1-pro-preview` writes noticeably better briefings but needs a billed
# project: free-tier keys get HTTP 429 for it. `gemini-3.1-flash-lite` is the
# cheapest stable JSON-mode model and works on a free-tier key. With the
# fallback below, either pin is safe: on a free-tier key the bridge tries Pro,
# gets 429, and answers from flash-lite on the same call.
GEMINI_MODEL=gemini-3.1-pro-preview
# Tried once, automatically, when GEMINI_MODEL answers 429 (no quota) or 404
# (retired). The model that actually answered is what every proposal records.
# Leave empty to disable the fallback. On a free-tier key, set GEMINI_MODEL to
# the fallback directly to save one failed round trip per call.
GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite
# off    - never call Gemini
# auto   - call it only when curated alias matching is weak or the unit is
#          unresolved (default; cheapest and fastest)
# always - call it for every reading (use for a demo where you want the AI
#          attribution visible on every card)
GEMINI_ASSIST_MODE=auto
GEMINI_ASSIST_BELOW_CONFIDENCE=0.95
# Ceiling on any AI-influenced confidence. Keep below 1.0 so no proposal can
# ever present itself as safe to publish without a human.
GEMINI_CONFIDENCE_CEILING=0.95
GEMINI_TIMEOUT_SECONDS=30
GEMINI_MAX_OUTPUT_TOKENS=2048
GEMINI_MAX_RETRIES=2
# 0 disables model "thinking" for lower latency. Set -1 to omit the field for
# models that do not accept it.
GEMINI_THINKING_BUDGET=0

# --- Terminology crosswalk ----------------------------------------------------
# Suggests a real LOINC/SNOMED CT code alongside the curated OAH code, for a
# reviewer to attach at approval time. Two sources, in order of precision:
#
#   1. The committed LOINC table, searched with the scope narrowed to
#      environmental specimens (Water/Air). Needs no key and no network, and is
#      what actually finds 9481-3 "pH of Water" and 12530-2 "Chloride in Water".
#   2. UMLS UTS search, to top up the rest -- notably SNOMED CT.
#
# Path to the published LOINC term table. Also used to reject UMLS results that
# are LOINC Parts (LP...) or Metathesaurus ids (MTHU...) rather than real LOINC
# codes. A missing file disables both search and validation, with a warning.
LOINC_TABLE_PATH=loinc/LoincTableCore/LoincTableCore.csv

# UMLS authenticates with the single `apiKey` query parameter documented at
# https://documentation.uts.nlm.nih.gov/rest/authentication.html -- get one free
# at https://uts.nlm.nih.gov/uts/profile once your UMLS license (usually a
# 3-business-day NLM review) is approved. This is NOT an OAuth2
# client_id/client_secret pair; an app-registration client_id/secret from
# elsewhere will not authenticate against this API.
# Leaving it empty is a supported, tested mode: local LOINC search keeps working
# and only SNOMED CT candidates become unavailable.
UMLS_API_KEY=
# Optional: the client id/secret NLM issues during the license request. Shown
# on the Integrations page for reference only; the UTS API never receives them.
UMLS_CLIENT_ID=
UMLS_CLIENT_SECRET=
UMLS_API_BASE=https://uts-ws.nlm.nih.gov/rest
UMLS_TIMEOUT_SECONDS=15
UMLS_MAX_RETRIES=2
# Comma-separated UMLS source-vocabulary abbreviations to search.
UMLS_VOCABULARIES=LNC,SNOMEDCT_US

# --- Live connectors ------------------------------------------------------------
# Hub'Eau (French national water open data) is keyless. Toulouse stations are
# listed in config/connectors.yaml.
HUBEAU_ENABLED=true
# Copernicus Data Space Ecosystem. Scene listing is keyless. Computing NDCI over
# a site needs an OAuth client from
# https://shapps.dataspace.copernicus.eu/dashboard/#/account/settings (free
# registration). Leaving these empty is a supported, tested mode: the scenes
# endpoint works and the NDCI endpoint returns 503 with an explanation.
SENTINEL2_ENABLED=true
CDSE_CLIENT_ID=
CDSE_CLIENT_SECRET=
